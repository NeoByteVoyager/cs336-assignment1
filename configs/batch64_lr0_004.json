{
    "model": {
        "vocab_size": 10000,
        "context_length": 256,
        "d_model": 512,
        "num_layers": 4,
        "num_heads": 16,
        "d_ff": 1344,
        "rope_theta": 10000
    },

    "optimizer": {
        "lr": 0.004,
        "weight_decay": 0.00001,
        "betas": [
            0.9,
            0.99
        ],
        "eps": 1e-8
    },

    "scheduler": {
        "min_lr": 0.00001,
        "warmup_steps": 100
    },

    "train": {
        "iteration": 4000,
        "batch_size": 64,
        "save_interval": 100,
        "context_length": 256,

        "gradient_clip":1.0,
        "log_path": "baseline.json",
        "checkpoint_path": "baseline.pt"
    }
}